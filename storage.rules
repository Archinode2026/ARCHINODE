rules_version = '2';

/* ══════════════════════════════════════════════════════════════════════════
   ARCHINODE — Cloud Storage 보안 규칙 (2026-11-05 신설, A-272)

   이 파일은 **버킷을 만든 뒤에** 쓸 수 있다. 2026-11-05 기준 프로젝트에
   Storage 버킷이 아직 없어서 업로드가 404 로 멈춘다 — 콘솔에서 먼저 켜야 한다.

   게시: npx firebase-tools deploy --only storage --project archinode-8ab04
        (tools/deploy.ps1 -Rules 는 firestore:rules 만 올린다. 아직 이 파일은 포함 안 됨.)

   설계
     · 쓰기는 **자기 uid 아래에만**. 경로의 {uid} 와 로그인한 사람이 같아야 한다.
       파일 이름을 Date.now() 로 만들기 때문에 남의 파일을 덮어쓸 걱정은 없지만,
       경로를 손으로 바꿔 넣는 것은 막아야 한다.
     · 읽기는 공개. 브랜드 로고·제품 사진·기사 이미지는 비로그인 방문자에게 보여야 한다.
       (주소를 아는 사람만 볼 수 있다 — 다운로드 URL 에 토큰이 붙는다.)
     · 용량·형식은 규칙에서도 한 번 더 막는다. 화면 쪽 검사는 우회할 수 있다.
     · 어드민은 모두 쓸 수 있다 — 대신 자료 정리·교체를 할 수 있어야 한다.
   ══════════════════════════════════════════════════════════════════════════ */

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // firestore.rules 의 ADMIN_EMAILS 와 같은 목록. 한쪽만 고치면 어긋난다.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'office@archinode.org',
        'wool21wool@gmail.com'
      ];
    }
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    // 화면은 1600px·JPEG 85% 로 줄여 올리므로 5MB 면 넉넉하다.
    function underImageLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }
    // 카탈로그·BIM·3D 는 이미지가 아니고 훨씬 크다.
    function underFileLimit() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    // ── 기사 이미지 (brand-portal/article-editor.js) ──
    match /articles/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(uid) && isImage() && underImageLimit()) || isAdmin();
    }

    // ── 제품 사진 (brand-portal/dashboard.html) ──
    match /products/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(uid) && isImage() && underImageLimit()) || isAdmin();
    }

    // ── 제품 자료: 카탈로그 PDF · BIM · 3D 모델 ──
    match /products-specs/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(uid) && underFileLimit()) || isAdmin();
    }

    // ── 인증서 (brand-portal/dashboard.html) ──
    //    KC·KS 같은 서류다. 공개 페이지에 걸지 않으므로 읽기도 본인과 어드민만.
    match /certifications/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) && underFileLimit()) || isAdmin();
    }

    // ── 그 밖의 모든 경로 ──
    //    새 기능이 규칙을 안 적고 올라가면 조용히 열려 있는 것보다 막히는 편이 낫다.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
