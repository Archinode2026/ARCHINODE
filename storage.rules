// ★ 2026-11-05 실측으로 갱신 (A-296). 아래 두 가지는 이제 사실이 아니다 —
//   (옛 주석) 「Storage 버킷이 아직 없어서 업로드가 404 로 멈춘다」
//   (옛 주석) 「deploy.ps1 -Rules 는 firestore:rules 만 올린다」
//   실제: 버킷 archinode-8ab04.firebasestorage.app 은 **존재**하고, 비인가 접근은
//   404 가 아니라 **403 Permission denied** 다. deploy.ps1 은 A-276 이후
//   firestore:rules,storage 를 함께 올린다.
//   그리고 이 파일의 규칙이 **실제로 배포돼 있다** — 어드민 세션 listAll() 실측:
//   articles/<uid>·products/<uid>·certifications/<uid> 는 성공, 루트와 임의 경로는
//   storage/unauthorized. Firebase 기본 잠금 규칙이면 세 경로도 거부된다.
//   ※ 404 와 403 을 가르는 것이 A-272 의 핵심이었다. 옛 주석이 그 함정을 되살려 놨었다.
rules_version = '2';

/* ══════════════════════════════════════════════════════════════════════════
   ARCHINODE — Cloud Storage 보안 규칙 (2026-11-05 신설, A-272)

   이 파일은 **버킷을 만든 뒤에** 쓸 수 있다. 2026-11-05 기준 프로젝트에

   게시: npx firebase-tools deploy --only storage --project archinode-8ab04

   설계
     · 쓰기는 **자기 uid 아래에만**. 경로의 {uid} 와 로그인한 사람이 같아야 한다.
       파일 이름을 Date.now() 로 만들기 때문에 남의 파일을 덮어쓸 걱정은 없지만,
       경로를 손으로 바꿔 넣는 것은 막아야 한다.
     · 읽기는 공개. 브랜드 로고·제품 사진·기사 이미지는 비로그인 방문자에게 보여야 한다.
       (주소를 아는 사람만 볼 수 있다 — 다운로드 URL 에 토큰이 붙는다.)
     · 용량·형식은 규칙에서도 한 번 더 막는다. 화면 쪽 검사는 우회할 수 있다.
     · **지우기는 따로 적는다.** Storage 규칙에서 delete 는 `write` 에 포함되는데,
       지울 때는 `request.resource` 가 **null** 이라 contentType·size 검사가 통과할 수 없다.
       create/update 와 한 줄로 묶으면 **본인도 자기 파일을 못 지운다**(실측으로 잡음).
     · 어드민은 모두 쓸 수 있다 — 대신 자료 정리·교체를 할 수 있어야 한다.
   ══════════════════════════════════════════════════════════════════════════ */

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // firestore.rules 의 ADMIN_EMAILS 와 같은 목록. 한쪽만 고치면 어긋난다.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'office@archinode.org',
        'wool21wool@gmail.com'
      ];
    }
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    // 화면은 1600px·JPEG 85% 로 줄여 올리므로 5MB 면 넉넉하다.
    function underImageLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }
    // 카탈로그·BIM·3D 는 이미지가 아니고 훨씬 크다.
    function underFileLimit() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    // ── 기사 이미지 (brand-portal/article-editor.js) ──
    match /articles/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isOwner(uid) && isImage() && underImageLimit()) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── 제품 사진 (brand-portal/dashboard.html) ──
    match /products/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isOwner(uid) && isImage() && underImageLimit()) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    /* ── 제품 자료: 카탈로그 PDF · BIM · 3D 모델 ──
       A-483(2026-11-12): `allow read: if true` 였다. read 는 **목록(list)까지** 허용하므로
       `listAll('products-specs')` 로 전 브랜드의 자료 파일을 **훑어서 받아갈 수** 있었다 —
       신청·승인 절차와 무관하게. 본인과 어드민만으로 닫는다.
       ※ 승인된 신청자에게 메일로 가는 링크는 `getDownloadURL()` 의 **토큰 URL** 이고,
         토큰 URL 은 이 규칙을 타지 않는다(토큰 자체가 권한이다). 그래서 여기를 닫아도
         이미 발송된 7일 링크는 그대로 열린다 — 막는 것은 **경로 훑기**다. */
    match /products-specs/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) && underFileLimit()) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── 인증서 (brand-portal/dashboard.html) ──
    //    KC·KS 같은 서류다. 공개 페이지에 걸지 않으므로 읽기도 본인과 어드민만.
    match /certifications/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) && underFileLimit()) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── 그 밖의 모든 경로 ──
    //    새 기능이 규칙을 안 적고 올라가면 조용히 열려 있는 것보다 막히는 편이 낫다.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
