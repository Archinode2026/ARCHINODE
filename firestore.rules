rules_version = '2';

// ========================================================================
// ARCHINODE — Firestore 보안 규칙 (프로덕션)
// 작성: 2026-05-07
// 기반: docs/firestore-schema.md 권장안 + 프로덕션 강화
// 게시 방법: Firebase Console → Firestore Database → Rules 탭에 전체 복사
// ========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────────
    // 헬퍼 함수
    // ────────────────────────────────────────────────────────────────────

    // 어드민 식별 (이메일 화이트리스트)
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.email == 'office@archinode.org' ||
         request.auth.token.email == 'wool21wool@gmail.com');
    }

    // 인증된 사용자
    function isSignedIn() {
      return request.auth != null;
    }

    // 본인 확인
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 신규 생성 시 status를 'pending'으로 강제
    // (사용자가 자기 문서를 자동 approved로 만드는 것 차단)
    function isNewStatusPending() {
      return request.resource.data.status == 'pending';
    }

    // 업데이트 시 immutable 필드 변경 방지
    // 2026-11-10 A-441: 예전 헬퍼는 request.resource.data[필드] == resource.data[필드] 였다.
    // Firestore 규칙은 **문서에 없는 키를 읽으면 식 전체가 오류**가 되어 그 분기가 거부된다. 그래서 보호
    // 필드 중 하나라도 문서에 없으면(브랜드 문서엔 history 가 없고, 승인 전 제품엔 approvedAt 이, 미게시
    // 글엔 publishedAt 이 없다) 소유자가 자기 문서를 **아무것도** 못 고치는 상태로 막혀 있었다.
    // diff().affectedKeys() 는 없는 키에도 오류를 내지 않고, 값 변경뿐 아니라 '없던 보호 필드를 새로
    // 넣는 것' 까지 함께 막는다.
    function notChangingAny(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // 허니팟 스팸 방지: 공개 폼의 숨겨진 'hp' 필드가 비어있어야 함(봇은 보통 모든 필드를 채움)
    function passesHoneypot() {
      return !('hp' in request.resource.data) || request.resource.data.hp == '';
    }

    // 브랜드 활성 상태 확인 (정지/거절/대기 브랜드가 배정된 리드 등에 계속 접근하는 것 차단)
    // 2026-11-02 QA: 정지(suspended)된 브랜드가 이미 배정된 리드를 그대로 읽고 메모까지 저장할 수 있었음
    function isApprovedBrand(uid) {
      return isSignedIn() && request.auth.uid == uid &&
        get(/databases/$(database)/documents/brands/$(uid)).data.status == 'approved';
    }

    // 좋아요 토글 — 제3자(전문가 회원)가 likeCount만 ±1 하도록 허용
    // 2026-11-03 QA A-144(검수관리 R-032): brands/products 의 update 규칙이
    // admin || 소유자 뿐이라, 전문가가 Like를 눌러도 likeCount 증가가
    // permission-denied 로 막혔다. users/{uid}.likedBrands 쪽은 본인 문서라
    // 통과해서 "내 페이지엔 뜨는데 숫자는 0" 인 상태가 됐다.
    //
    // 단순히 isSignedIn() 으로 열면 누구나 likeCount 를 임의 값으로 덮어쓸 수
    // 있으므로, 다음을 모두 요구한다:
    //   1) likeCount 외의 필드는 하나도 바뀌지 않을 것
    //   2) 변화량이 정확히 +1 또는 -1 이고 결과가 음수가 아닐 것
    //   3) 본인 users 문서의 좋아요 목록과 방향이 일치할 것
    //      (+1 이면 목록에 있어야 하고, -1 이면 없어야 한다)
    // 3) 때문에 한 사용자가 같은 대상에 기여할 수 있는 값은 최대 +1 이다.
    // 클라이언트는 users 문서를 먼저 쓰고 그다음 likeCount 를 올린다(순서 중요).
    function likedList(field) {       // 이 쓰기 **전**의 내 목록
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get(field, []);
    }
    function likedListAfter(field) {  // 이 쓰기 **후**의 내 목록 (같은 batch 안이어야 달라진다)
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get(field, []);
    }
    /* A-482(2026-11-12): 전에는 「+1 은 내 목록에 **있으면**, -1 은 **없으면**」 이었다.
       목록은 내가 쓰는 내 문서이므로, 먼저 목록에 넣고 나서 +1 을 **몇 번이든** 보낼 수 있었고
       (규칙 주석의 「최대 +1」 은 사실이 아니었다), 목록에서 빼고 나면 **한 번도 좋아하지 않은**
       아무 승인 문서나 -1 로 0 까지 깎을 수 있었다. 카운터를 목록의 **변화**에 묶는다 —
       +1 은 「전에 없었고 후에 있다」, -1 은 「전에 있었고 후에 없다」. getAfter 는 같은
       batch 안의 결과를 보므로, 클라이언트는 목록과 카운터를 **한 묶음(batch)** 으로 써야 한다.
       따로 쓰면 getAfter 가 지금 값과 같아져 규칙이 거부한다 — 그게 의도다. */
    function isLikeToggle(docId, field) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && resource.data.status == 'approved'
        && ((request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
             && !(docId in likedList(field))
             && (docId in likedListAfter(field)))
            || (request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
                && (docId in likedList(field))
                && !(docId in likedListAfter(field))));
    }

    // ────────────────────────────────────────────────────────────────────
    // brands 컬렉션
    // 문서 ID = Firebase Auth UID
    // status: 'pending' | 'approved' | 'suspended' | 'rejected'
    //   - pending:   신규 입점 신청 (어드민 검토 대기)
    //   - approved:  승인 → 카테고리·brands.html 노출
    //   - suspended: 임시 정지 (노출 차단, 어드민이 Restore로 복구 가능)
    //   - rejected:  거절 (영구 비노출, 어드민이 Restore로 복구 가능)
    // 어드민 전용 필드: statusReason, statusChangedAt, statusChangedBy
    // ────────────────────────────────────────────────────────────────────
    match /brands/{brandId} {
      // 읽기: approved 문서는 누구나, 본인/어드민은 모든 상태 가능
      allow read: if resource.data.status == 'approved'
                  || isOwner(brandId)
                  || isAdmin();

      // 생성: 인증된 사용자가 본인 UID 문서만, status는 'pending' 강제
      allow create: if isOwner(brandId)
                    && isNewStatusPending()
                    && passesHoneypot()
                    && request.resource.data.brandName is string
                    && request.resource.data.email is string;

      // 수정:
      //   - 어드민: status를 4값 중 하나로만 변경 가능
      //   - 본인: status·createdAt·brandName·approvedAt·statusReason·statusChangedAt·statusChangedBy·history 변경 금지
      allow update: if (isAdmin()
                       && request.resource.data.status in ['pending','approved','suspended','rejected'])
                    || (isOwner(brandId)
                        && notChangingAny(['status', 'createdAt', 'brandName', 'approvedAt',
                                           'statusReason', 'statusChangedAt', 'statusChangedBy',
                                           'history']))   // history 는 어드민만(2026-09-12 블랙 지적)
                    || isLikeToggle(brandId, 'likedBrands');   // 2026-11-03 A-144

      // 삭제: 어드민만
      allow delete: if isAdmin();
    }

    // brands/{brandId}/internal — 2026-11-03 QA A-027: 정지·거절 사유(statusReason)와 상태변경
    // 이력(history[], 관리자 이메일 포함)이 brands 본문 필드로 있으면 status=='approved'인 순간
    // 전체 문서가 공개 read 대상이 되어 과거 사유·어드민 이메일이 그대로 노출됨(실측 확인:
    // 승인된 브랜드 2건에서 wool21wool@gmail.com과 내부 QA 메모가 공개로 읽힘). 이 서브컬렉션으로
    // 분리해 어드민만 읽고 쓸 수 있게 한다 — 공개 brands 문서에는 더 이상 이 필드들을 쓰지 않는다.
    match /brands/{brandId}/internal/{docId} {
      /* ★★ A-480(2026-11-12, 브론즈 30차 ⑧): 승인된 브랜드 문서는 **문서 전체가
         공개 읽기**다(`status == 'approved'`). 그래서 담당자 개인정보가 화면에는
         하나도 안 그려지는데 Firestore 질의로는 **전량 수집**됐다 —
         `contactName` · `position` · `email` · `phone` · `referral` ·
         `referralSource` · `agreedVendorTermsAt`. 유럽 브랜드 담당자의 실명·직책·
         직통 전화가 GDPR 대상 개인정보다. A-027 이 `statusReason`·`history` 를
         이 서브컬렉션으로 뺀 바로 그 처방을 **본문 필드에는 적용하지 않았다.**
         이제 `contact` 문서로 뺀다.

         `moderation` 은 어드민만(검수 메모 — 브랜드가 보면 안 된다).
         `contact` 는 **본인 브랜드와 어드민**이 읽고 쓴다 — 입점 신청이
         자기 계정으로 만들고(그 시점에 로그인 상태다), 브랜드가 나중에
         담당자 연락처를 고칠 수 있어야 한다. */
      allow read, write: if isAdmin();
    }
    match /brands/{brandId}/internal/contact {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == brandId);
    }

    // ────────────────────────────────────────────────────────────────────
    // products 컬렉션
    // 문서 ID = 자동 생성
    // ────────────────────────────────────────────────────────────────────
    match /products/{productId} {
      // 읽기: approved는 누구나, 소유 브랜드/어드민은 모든 상태
      allow read: if resource.data.status == 'approved'
                  || (isSignedIn() && request.auth.uid == resource.data.brandId)
                  || isAdmin();

      // 생성: 인증된 사용자가 본인 brandId로만, status는 'pending' 강제
      // 2026-11-02: isApprovedBrand() 추가 — 정지·거절·대기 브랜드는 신규 제품 등록 불가
      allow create: if isApprovedBrand(request.resource.data.brandId)
                    && isNewStatusPending()
                    && request.resource.data.name is string
                    && request.resource.data.category is string;

      // 수정: 소유 브랜드 또는 어드민. status·brandId·createdAt 보호
      // 2026-11-02: isApprovedBrand() 추가 — 정지(suspended)된 브랜드는 공개 노출 차단과 동일하게
      // 자기 제품을 더 이상 수정할 수 없다(leads 인박스 건과 동일 패턴)
      // 2026-11-11 A-467 (승리님 결정: 「다시 심사 대기로」): 전에는 브랜드가 자기 제품을
      // **고치는 길이 아예 없었다** — 포털은 add() 만 하고 어드민도 승인·반려만 눌렀다.
      // 사진 없이 올라간 제품은 영영 사진이 없고 오타도 영영 남았다.
      // 이제 소유 브랜드가 고칠 수 있지만, **고친 결과는 반드시 'pending'** 이다.
      // approved 로 스스로 올리는 길은 없다 — 검수를 건너뛰고 공개되는 문은 열리지 않는다.
      // status 를 조건으로 **읽지 않고** request.resource 쪽만 본다. resource.data.status
      // 는 항상 있는 필드지만, 없는 필드를 비교하면 분기 전체가 거부되는 함정(A-441)을
      // 다시 밟지 않으려고 비교는 notChangingAny(diff) 로만 한다.
      allow update: if isAdmin()
                    || (isApprovedBrand(resource.data.brandId)
                        && request.resource.data.status == 'pending'
                        && notChangingAny(['brandId', 'createdAt', 'approvedAt']))
                    || isLikeToggle(productId, 'likedProducts');   // 2026-11-03 A-144

      // 삭제: 어드민만
      allow delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // articles 컬렉션 (매거진)
    // 문서 ID = 자동 생성
    // ────────────────────────────────────────────────────────────────────
    match /articles/{articleId} {
      // 읽기: approved는 누구나, 소유 브랜드/어드민은 모든 상태
      allow read: if resource.data.status == 'approved'
                  || (isSignedIn() && request.auth.uid == resource.data.brandId)
                  || isAdmin();

      // 생성: 인증된 사용자가 본인 brandId로만, status는 'pending'
      // (어드민이 직접 발행 시에는 별도로 approved 가능 — 어드민은 update로 status 변경)
      // 2026-11-02: isApprovedBrand() 추가 — 정지·거절·대기 브랜드는 신규 매거진 글 제출 불가
      // A-315(2026-11-06): isAdmin() 이 빠져 있었다. 바로 위 주석은 「어드민이 직접 발행 시에는
      //   별도로 approved 가능」이라고 적고 있는데 **규칙이 그걸 허용하지 않았다** — 주석과 규칙이
      //   어긋나 있었고, 실무적으로 **편집부가 기사를 직접 올릴 경로가 없었다**(정적 파일로만 가능).
      //   브론즈가 어드민 세션으로 두 가지 brandId 를 시도해 둘 다 permission-denied 로 실측했다:
      //     brandId = 브랜드 uid → isApprovedBrand() 가 request.auth.uid == uid 를 요구해 실패
      //     brandId = 어드민 uid → brands/{adminUid} 문서가 없어 get() 실패
      allow create: if isAdmin()
                    || (isApprovedBrand(request.resource.data.brandId)
                        && isNewStatusPending()
                        && request.resource.data.title is string);

      // 수정: 소유 브랜드 또는 어드민. status·brandId·createdAt 보호
      // 2026-11-02: isApprovedBrand() 추가 — 정지된 브랜드는 자기 매거진 글도 더 이상 수정할 수 없다
      allow update: if isAdmin()
                    || (isApprovedBrand(resource.data.brandId)
                        && notChangingAny(['status', 'brandId', 'createdAt', 'publishedAt']));

      // 삭제: 어드민만
      allow delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // users 컬렉션 (Phase 2B — 국내 전문가 계정)
    // 문서 ID = Firebase Auth UID
    // ────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // 읽기·쓰기: 본인만. 어드민은 별도로 모두 가능
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'professional'
                    && request.resource.data.email is string;
      allow update: if isOwner(userId)
                    && notChangingAny(['email', 'createdAt', 'role']);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // leads 컬렉션 — 리드 인박스 (2026-09-12 어드민 개편 4a 활성. 필드는 docs/firestore-schema.md 9절)
    // 문서 ID = 자동 생성. type 'quote'|'brand-inquiry'|'dealer', status new→assigned→contacted→closed | spam
    // 4a: 어드민 수동 등록(admin/js/view-leads.js) + 브랜드 포털 Inbox 탭. 공개 폼(4b)은 한울님 복귀 후.
    // ────────────────────────────────────────────────────────────────────
    match /leads/{leadId} {
      // 생성: 누구나(4b 공개 폼 대비) — type·status=='new'·name·email·message·createdAt==request.time 검사
      //       (기존 조건 email·createdAt 에 type·status·name·message 를 더한 좁히기 — 4a 전에는 create 를 쓰는 곳이 없었다)
      allow create: if passesHoneypot()
                    && request.resource.data.type in ['quote','brand-inquiry','dealer','sample-request','sourcing']
                    && request.resource.data.status == 'new'
                    && request.resource.data.name is string && request.resource.data.name.size() > 0
                    && request.resource.data.email is string && request.resource.data.email.size() > 5
                    && request.resource.data.message is string
                    && request.resource.data.createdAt == request.time;
      // 읽기: 어드민, 또는 배정된 브랜드 본인 — 브랜드는 배정된 건만(2026-09-12 블랙 지적: 위조 brandId·spam 되돌림 노출 차단)
      //       포털 조회는 where('brandId','==',uid).where('status','in',[...]) — 두 조건이 이 규칙과 정확히 같아야 list 판정이 통과한다
      //       2026-11-02: isApprovedBrand() 추가 — 정지(suspended)·거절(rejected)·대기(pending) 브랜드는
      //       본인 UID가 일치해도 이미 배정된 고객 리드(이름·이메일·전화번호)를 더 이상 읽을 수 없다
      allow read: if isAdmin()
                  || (isApprovedBrand(resource.data.brandId)
                      && resource.data.status in ['assigned','contacted','closed']);
      // 수정: 어드민 전부 / 브랜드는 배정 건에서 status·brandNote·history·updatedAt 만, status 는 assigned·contacted·closed 만
      //       2026-11-02: isApprovedBrand() 추가 — 정지된 브랜드가 배정된 리드에 메모를 남기거나 상태를 바꾸는 것(응대 지속)을 차단
      allow update: if isAdmin()
                    || (isApprovedBrand(resource.data.brandId)
                        && resource.data.status in ['assigned','contacted','closed']
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','brandNote','history','updatedAt'])
                        && request.resource.data.status in ['assigned','contacted','closed']
                        // A-481: history 는 **줄어들 수 없다**. 전에는 키만 봤으므로 브랜드가
                        //   history: [] 로 감사 기록을 전부 지울 수 있었다(arrayUnion 은 통과한다).
                        && (!('history' in resource.data)
                            || (request.resource.data.history is list
                                && request.resource.data.history.size() >= resource.data.history.size())));
      // 삭제: 어드민만
      allow delete: if isAdmin();
    }

    /* A-481(2026-11-12): 어드민 메모(adminNote)와 어드민이 남긴 상태 메모·어드민 이메일을
       여기로 옮겼다. 배정된 브랜드는 위 규칙으로 리드 문서를 **통째로** 읽을 수 있고
       Firestore 에는 필드 단위 읽기가 없다 — 그래서 「화면에 안 그린다」로는 가려지지 않았다.
       문서의 history[] 에는 이제 어드민 쪽 뼈대만 남는다(status·at·byRole). */
    match /leads/{leadId}/internal/{docId} {
      allow read, write: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // trend-submissions 컬렉션 (Trend Report 원고 제출 — 2026-05-10 신설)
    // 유럽 브랜드가 비로그인 상태로 원고 제출 → 어드민(편집부)이 검토 → 승인/거절
    // 문서 ID = 자동 생성
    // ────────────────────────────────────────────────────────────────────
    match /trend-submissions/{submissionId} {
      // 생성: 누구나 (방문자 폼 제출). 필수 필드 검증 + status 'pending' 강제
      // 2026-05-11 업데이트: body → originalBody/englishBody로 분리, originalLang 추가 (3국어 토글 지원)
      allow create: if request.resource.data.brandName is string
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 5
                    && request.resource.data.title is string
                    && request.resource.data.originalLang is string
                    && request.resource.data.originalLang in ['en','it','de','fr','es','nl','da','ko']
                    && request.resource.data.originalBody is string
                    && request.resource.data.originalBody.size() >= 200
                    && request.resource.data.englishBody is string
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time;

      // 읽기·수정·삭제: 어드민만 (편집부 검토 권한)
      allow read, update, delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // consultations 컬렉션 (한국 시장 자문 요청 — 2026-05-13 신설)
    // 방문자가 비로그인 상태로 요청 제출 → 어드민(한울님)이 검토 → 사전답변/미팅/거절
    // 문서 ID = 자동 생성
    // 필드: companyName, contactName, email, phone, website, country,
    //       category ('market-entry'|'partnership-match'|'material-sourcing'|'other'),
    //       description (100자 이상), timing, budget,
    //       status ('pending'|'triaged'|'scheduled'|'completed'|'rejected'),
    //       triageNote, reviewerNote, paymentLink, meetingAt, resolutionType,
    //       reviewedAt, createdAt
    // ────────────────────────────────────────────────────────────────────
    match /consultations/{consultId} {
      // 생성: 누구나 (방문자 폼 제출). 필수 필드 검증 + status 'pending' 강제
      allow create: if passesHoneypot()
                    && request.resource.data.companyName is string
                    && request.resource.data.contactName is string
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 5
                    && request.resource.data.country is string
                    && request.resource.data.category is string
                    && request.resource.data.category in ['market-entry','partnership-match','material-sourcing','other']
                    && request.resource.data.description is string
                    && request.resource.data.description.size() >= 100
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time;

      // 읽기·수정·삭제: 어드민만
      allow read, update, delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // digital-products-notify 컬렉션 (디지털 상품 출시 알림 신청 — 2026-05-13 신설)
    // 방문자 이메일만 단순 수집. 출시 시 1회 알림 발송용.
    // ────────────────────────────────────────────────────────────────────
    match /digital-products-notify/{docId} {
      allow create: if passesHoneypot()
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 5
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // newsletter-subscribers 컬렉션 (Newsletter 구독 — 2026-06-15 신설)
    // index.html, magazine.html, trend-report.html 폼에서 비로그인 제출.
    // 필드: email, source ('home'|'magazine'|'trend-report'|기타), createdAt
    // 한울님이 6/15에 Firebase Console에 직접 게시한 룰을 이 파일에 동기화 (2026-06-23).
    // ────────────────────────────────────────────────────────────────────
    match /newsletter-subscribers/{docId} {
      allow create: if passesHoneypot()
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 5
                    && request.resource.data.source is string
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // mail 컬렉션 (어드민 이메일 알림 — Firebase Extensions "Trigger Email" — 2026-06-30 신설)
    // 사이트 폼이 create만 함. Extension이 문서 감지 후 이메일 발송.
    // ────────────────────────────────────────────────────────────────────
    match /mail/{docId} {
      /* ★★ A-477(2026-11-12, 브론즈 30차 ①): 전에는 생성 조건이 **셋뿐**이었다 —
         `to is string` · `message.subject is string` · `subject.size() < 200`.
         인증도, 허니팟도, **수신자 제한도, 본문 제한도 없었다.**
         Trigger Email 확장은 **검증된 archinodekr.com 도메인**으로 발송한다.
         즉 누구나 Firestore 에 문서 하나를 넣어 **ARCHINODE 이름으로 임의 주소에
         임의 내용의 메일을 무제한 보낼 수 있었다** — 피싱에 그대로 쓰이고,
         도메인 평판(SPF·DKIM)이 타면 정작 우리 알림 메일이 스팸으로 떨어진다.

         이제 세 갈래만 허용한다.
           ㄱ. 어드민 — 누구에게나(답장·자격증명 발송). 토큰의 서명된 email 클레임.
           ㄴ. 비로그인·로그인 누구든 — **운영자 주소로만**. 공개 폼 6곳이
               전부 `office@archinode.org` 고정이라 이걸로 충분하다(전수 확인).
           ㄷ. 로그인한 본인 — **자기 주소로만**. 입점 신청의 접수 확인 메일
               한 자리다. 그래서 `list-your-brand.html` 의 `signOut()` 을
               메일 쓰기 **뒤로** 옮겼다(A-477).
         본문 상한도 함께 둔다 — 전에는 `message.text` 검증이 **0개**여서
         1MiB 문서를 무한히 만들 수 있었다. */
      function mailShapeOk() {
        return request.resource.data.to is string
               && request.resource.data.to.size() < 200
               && request.resource.data.message.subject is string
               && request.resource.data.message.subject.size() < 200
               && (!('text' in request.resource.data.message)
                   || (request.resource.data.message.text is string
                       && request.resource.data.message.text.size() < 20000))
               && (!('html' in request.resource.data.message)
                   || (request.resource.data.message.html is string
                       && request.resource.data.message.html.size() < 20000));
      }
      allow create: if isAdmin()
                    || (mailShapeOk()
                        && request.resource.data.to == 'office@archinode.org')
                    || (isSignedIn() && mailShapeOk()
                        && request.resource.data.to == request.auth.token.email);
      // 읽기/수정/삭제: 어드민만
      allow read, update, delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // reviewIssues 콜렉션 — 검수관리 게시판 (2026-09-12, 오픈 전 임시 도구)
    // 브론즈·블랙·어드민이 발견한 결함을 등록하고 상태를 굴린다. 어드민 전용.
    // ────────────────────────────────────────────────────────────────────
    match /reviewIssues/{issueId} {
      allow read, write: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // adminLogs — 어드민 활동 장부 (2026-09-12, 개편 2단계). 덧붙이기만 된다: 어드민이라도 수정·삭제 불가.
    // 필드: at(serverTimestamp), by, action, target{col,id,label}, from, to, note, page — docs/firestore-schema.md 7절
    // ────────────────────────────────────────────────────────────────────
    match /adminLogs/{logId} {
      allow create, read: if isAdmin();
      allow update, delete: if false;
    }

    // ────────────────────────────────────────────────────────────────────
    // settings — 정책 값·사이트 정보 (2026-09-12, 개편 3단계).
    // 문서 1개 settings/config — docs/firestore-schema.md 8절. 쓰기는 어드민만(어드민 > 설정 화면).
    //
    // ★★ A-479(2026-11-12, 브론즈 30차 ⑦): 전에는 `allow read: if true` 였다.
    //    주석은 「개인정보 없음. 공개 페이지가 읽을 수 있게 read 공개」라고 적었는데
    //    **두 전제가 다 틀렸다.**
    //    ㄱ. 이 문서에는 `adminNotice` 가 들어간다 — 설정 화면의 라벨이
    //        「어드민 메모 (대시보드 상단 표시)」인 **자유 입력 textarea** 다
    //        (admin/js/view-settings.js:65). `updatedBy` 로 어드민 이메일도 함께 쓴다.
    //        자유 입력에 무엇이 들어갈지는 규칙이 보장할 수 없다 —
    //        A-027(statusReason·history 가 공개 brands 문서에 있어 유출)과 같은 구조다.
    //    ㄴ. **공개 페이지가 읽는 곳이 하나도 없다.** 전수로 셌다 —
    //        `settings` 를 읽는 자리는 `admin/js/view-dashboard.js:56` 과
    //        `admin/js/view-settings.js:166` **둘뿐**이고 둘 다 어드민 화면이다.
    //        공개를 위해 열어 둔 문이었는데 그 쓰임이 끝내 생기지 않았다.
    //    사업자 정보는 어차피 푸터 마크업에 박혀 있다(A-176, 231개 파일) —
    //    공개로 읽어야 할 필요도 없다. 나중에 공개 페이지가 사이트 정보를 읽어야
    //    하면 **공개용 문서를 따로** 두고 거기만 열어라. 이 문서는 닫는다.
    // ────────────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // notices — 공지사항 (2026-09-12, 개편 5단계). 어드민이 쓰고 브랜드 포털 배너가 읽는다.
    // 필드: title_en/ko, body_en/ko(평문), audience(brand|site|all), visible, pinned, order, createdAt/By, updatedAt/By — docs/firestore-schema.md 10절
    // read: 어드민 ∪ (로그인 ∧ visible==true). 포털 조회는 where('visible','==',true) 만(문서별 판정과 일치).
    // 사이트 공개 공지(비로그인)는 복귀 후 `|| resource.data.audience in ['site','all']` 로 한 번 더 넓힌다.
    // ────────────────────────────────────────────────────────────────────
    match /notices/{noticeId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.visible == true);
      allow create, update, delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // inquiries — 1:1 문의 (2026-09-12, 개편 5단계). 브랜드 포털 Support 탭이 create, 어드민이 답변(update).
    // 필드: fromUid, fromRole, fromEmail, fromName, subject, body, status(open|answered), answer, answeredAt/By, createdAt, updatedAt, history — docs/firestore-schema.md 11절
    // create: 로그인 본인 uid · fromEmail == 로그인 계정 이메일 · status open · subject 1~199자 · body 1~4999자 · createdAt == request.time
    // read: 본인 ∪ 어드민 (포털 조회는 where('fromUid','==',uid) 만) / update·delete 어드민
    // ────────────────────────────────────────────────────────────────────
    match /inquiries/{inquiryId} {
      allow create: if isSignedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.fromEmail == request.auth.token.email   // 작성자 이메일은 로그인 계정과 같아야(2026-09-12 블랙 지적)
                    && request.resource.data.status == 'open'
                    && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() < 200
                    && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() < 5000
                    && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (isSignedIn() && resource.data.fromUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // bim-requests 컬렉션 (BIM/CAD/3D 파일 요청 승인제 — 2026-11-02 신설)
    // 전문가가 신청서 제출 → 어드민 승인 → 시간제한(expiresAt) 접근 허가.
    // 문서 ID = 자동 생성. status: 'pending' | 'approved' | 'rejected'
    // 필드: productId, brandId, requesterUid, name, company, title, email, phone,
    //       projectName, projectType, projectTimeline, projectScale,
    //       agreedDataTerms(true 고정), agreedThirdPartyShare(true 고정),
    //       status, fileUrl(승인 시 어드민이 채움), expiresAt(승인 시 어드민이 채움),
    //       createdAt, reviewedAt, reviewedBy
    // ────────────────────────────────────────────────────────────────────
    match /bim-requests/{requestId} {
      // 생성: 로그인한 전문가 본인만, 동의 체크박스 2개 모두 true, status는 'pending' 강제,
      //       fileUrl·expiresAt은 아직 비어있어야(승인 전에 미리 채워 넣는 것 차단)
      allow create: if isSignedIn()
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.agreedDataTerms == true
                    && request.resource.data.agreedThirdPartyShare == true
                    && request.resource.data.status == 'pending'
                    && request.resource.data.name is string && request.resource.data.name.size() > 0
                    && request.resource.data.email is string && request.resource.data.email.size() > 5
                    && request.resource.data.projectName is string && request.resource.data.projectName.size() > 0
                    && request.resource.data.productId is string
                    && (!('fileUrl' in request.resource.data) || request.resource.data.fileUrl == '')
                    && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt == null)
                    && request.resource.data.createdAt == request.time;

      // 읽기: 신청자 본인 또는 어드민만 — 다운로드 페이지가 status·expiresAt 확인할 때도 이 규칙을 탐
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.requesterUid == request.auth.uid);

      // 수정: 어드민만, status·fileUrl·expiresAt·reviewedAt·reviewedBy만 변경 가능(신청 원본 내용은 보존)
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status','fileUrl','expiresAt','reviewedAt','reviewedBy'])
                    && request.resource.data.status in ['pending','approved','rejected'];

      // 삭제: 어드민만 (승인 즉시 회수하고 싶을 때)
      allow delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────
    // 기본 정책: 위에 매칭되지 않는 모든 경로 차단
    // ────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
